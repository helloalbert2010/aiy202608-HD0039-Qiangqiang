{
  "name": "myarchive-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node mobile-api/start.js",
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:mobile-api": "node --test mobile-api/server.test.js",
    "check": "node scripts/check-project.mjs && node scripts/check-submission.mjs && node scripts/check-audio-chunks.mjs && node scripts/check-growth-profile.mjs && npm run check:mobile-api",
    "check:submission": "node scripts/check-submission.mjs",
    "verify:mobile-api": "node scripts/verify-mobile-api-live.mjs",
    "verify": "npm run check && npm run build"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "docx": "^9.7.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide": "^0.468.0",
    "three": "^0.179.1"
  }
}
