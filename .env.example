# Public client configuration only. Do not add database passwords or service-role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local competition demo only. Vite embeds these values in the browser bundle.
# Use a server-side proxy before any public deployment.
VITE_DEEPSEEK_API_KEY=
VITE_GLM_API_KEY=

# Independent mobile API (server-only; never copy these variables into the APK).
HOST=127.0.0.1
PORT=8787
TZ=Asia/Shanghai
CORS_ORIGIN=*
MAX_BODY_BYTES=1048576
DATABASE_TIMEOUT_MS=10000
AGENT_TIMEOUT_MS=30000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AGENT_API_URL=
AGENT_API_KEY=
